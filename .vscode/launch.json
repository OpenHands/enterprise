{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SaaS Server (port 3030)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "saas_server:app",
                "--host",
                "0.0.0.0",
                "--port",
                "3030"
            ],
            "env": {
                "DEBUG": "1",
                "OPENHANDS_CONFIG_CLS": "server.config.SaaSServerConfig",
                "SERVE_FRONTEND": "false",
                "FILE_STORE": "local",
                "FILE_STORE_PATH": "/tmp/.openhands-state",
                "FRONTEND_DIRECTORY": "${workspaceFolder}/frontend/build",
                "WEB_HOST": "localhost",
                "PERMITTED_CORS_ORIGINS": "http://localhost:3030",
                "DB_HOST": "127.0.0.1",
                "DB_PORT": "5432",
                "DB_NAME": "openhands",
                "DB_USER": "postgres",
                "KEYCLOAK_SERVER_URL": "https://keycloak.staging.all-hands.dev",
                "KEYCLOAK_SERVER_URL_EXT": "https://keycloak.staging.all-hands.dev",
                "KEYCLOAK_REALM_NAME": "allhands",
                "KEYCLOAK_CLIENT_ID": "openhands",
                "AUTH_WEB_HOST": "keycloak.staging.all-hands.dev",
                "LITE_LLM_API_URL": "https://llm-proxy.staging.all-hands.dev",
                "LITE_LLM_TEAM_ID": "62ea39c4-8886-44f3-b7ce-07ed4fe42d2c"
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Unit Tests (all)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "./tests/unit"
            ],
            "env": {
                "DEBUG": "1",
                "DB_HOST": "127.0.0.1",
                "DB_PORT": "5432",
                "DB_NAME": "openhands",
                "DB_USER": "postgres"
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Unit Tests (single file)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "${file}"
            ],
            "env": {
                "DEBUG": "1",
                "DB_HOST": "127.0.0.1",
                "DB_PORT": "5432",
                "DB_NAME": "openhands",
                "DB_USER": "postgres"
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Frontend Tests (npm test)",
            "command": "npm test",
            "request": "launch",
            "type": "node-terminal",
            "cwd": "${workspaceFolder}/frontend",
            "sourceMaps": true
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Legacy OpenHands OSS",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "openhands.server.listen:app",
                "--reload",
                "--reload-include",
                "openhands",
                "--host",
                "0.0.0.0",
                "--port",
                "3000"
            ],
            "env": {
                "PERMITTED_CORS_ORIGINS": "http://localhost:3001",
                "INIT_GIT_IN_EMPTY_WORKSPACE": "1",
                "ENABLE_MCP_SEARCH_ENGINE": "true",
                "OH_WEB_CLIENT_KIND": "DefaultWebClientConfigInjector"
            },
            "justMyCode": false
        }
    ]
}
