# Copy to an untracked .env.auth and supply the blank values.
ENABLE_KEYCLOAK=false
APP_MODE=saas
OH_APP_MODE=saas
OH_DEPLOYMENT_MODE=self_hosted
OPENHANDS_CONFIG_CLS=server.config.SaaSServerConfig
WEB_HOST=localhost
OH_WEB_URL=http://localhost:3000
AUTH_ALLOW_INSECURE_LOCALHOST=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=openhands_auth
DB_USER=postgres
DB_PASS=
JWT_SECRET=
# Used only when first startup creates the initial administrator.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Supply your existing managed LLM provisioning configuration.
LITE_LLM_API_URL=
LITE_LLM_API_KEY=
LITE_LLM_TEAM_ID=

ENABLE_ENTERPRISE_SSO=false
ENABLE_LINEAR=false
SLACK_WEBHOOKS_ENABLED=false
