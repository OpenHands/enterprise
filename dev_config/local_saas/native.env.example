# Copy to an untracked .env.native and supply the blank values.
ENABLE_KEYCLOAK=false
ENABLE_LITELLM=false
APP_MODE=saas
OH_APP_MODE=saas
OH_DEPLOYMENT_MODE=self_hosted
OPENHANDS_CONFIG_CLS=server.config.SaaSServerConfig
WEB_HOST=localhost
NATIVE_AUTH_APP_ORIGIN=http://localhost:3000
# For localhost development only. Use HTTPS and false elsewhere.
NATIVE_AUTH_ALLOW_INSECURE_LOCALHOST=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=openhands_native
DB_USER=postgres
DB_PASS=
JWT_SECRET=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Optional direct LLM defaults. Supply your endpoint and model, or use Settings.
# OPENHANDS_LLM_PROVIDER_ROUTE=direct
# OPENHANDS_DEFAULT_LLM_MODEL=
# OPENHANDS_DEFAULT_LLM_BASE_URL=
# OPENHANDS_DEFAULT_LLM_API_KEY=

# Optional managed LiteLLM provisioning. Enable it and supply its configuration.
# ENABLE_LITELLM=true
# LITE_LLM_API_URL=
# LITE_LLM_API_KEY=
# LITE_LLM_TEAM_ID=

ENABLE_ENTERPRISE_SSO=false
ENABLE_LINEAR=false
SLACK_WEBHOOKS_ENABLED=false
