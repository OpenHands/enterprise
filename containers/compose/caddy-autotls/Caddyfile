# Single-origin reverse proxy with automatic TLS.
#
#   Local:  SITE_ADDRESS=localhost           -> Caddy internal CA (offline, no DNS)
#   Hosted: SITE_ADDRESS=proxy.example.com   -> automatic Let's Encrypt via ACME
#           (needs public DNS A/AAAA -> this host and ports 80 + 443 reachable)
#
# For a company-provided certificate instead of ACME, add inside the site block:
#     tls /certs/cert.pem /certs/key.pem
# and mount the certificate directory in the overlay. For a Let's Encrypt
# contact address, add a global options block at the top:  { email you@host }

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Automation owns the /api/automation prefix; forward it unchanged.
	@automation path /api/automation /api/automation/*
	handle @automation {
		reverse_proxy automation:8000 {
			stream_close_delay 1m
			transport http {
				dial_timeout 2s
				response_header_timeout 15s
			}
		}
	}

	# Everything else is Enterprise.
	handle {
		reverse_proxy enterprise:3000 {
			stream_close_delay 1m
		}
	}
}
