# Copy to .env, supply unique secrets, and keep the file private (chmod 600).
# Do not print `docker compose config` with real secrets; use `config --quiet`.
ENTERPRISE_DB_PASSWORD=
AUTOMATION_DB_PASSWORD=
AUTOMATIONS_SERVICE_KEY=
AUTOMATION_WEBHOOK_SECRET=
AUTOMATION_KV_SECRET=
PUBLIC_HOST=localhost:8443
# Reserve the proxy IP within this subnet; change both if your network overlaps.
COMPOSE_SUBNET=172.30.44.0/24
PROXY_IPV4_ADDRESS=172.30.44.10
KEYCLOAK_SERVER_URL=
KEYCLOAK_SERVER_URL_EXT=
KEYCLOAK_REALM_NAME=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_PASSWORD=
