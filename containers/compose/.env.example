# Generate a private root .env with: python3 containers/compose/setup.py
COMPOSE_PROJECT_NAME=openhands-enterprise
OPENHANDS_PORT=3000
DOCKER_SOCKET_PATH=/var/run/docker.sock
DB_NAME=openhands
DB_USER=openhands
DB_PASSWORD=
JWT_SECRET=
SUPERADMIN_EMAIL=admin@example.test
SUPERADMIN_PASSWORD=

# Optional compatible Agent Server image. The bundled SDK selects the default.
# COMPOSE_AGENT_SERVER_IMAGE=registry.example.com/my-agent-server:compatible-release
