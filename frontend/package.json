{
  "name": "openhands-frontend",
  "version": "1.92.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@heroui/react": "2.8.8",
    "@microlink/react-json-view": "1.31.48",
    "@monaco-editor/react": "4.7.0",
    "@openhands/extensions": "0.41.0",
    "@react-router/node": "7.17.0",
    "@react-router/serve": "7.17.0",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-query": "5.106.1",
    "@uidotdev/usehooks": "2.4.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "axios": "1.21.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "downshift": "9.4.0",
    "driver.js": "1.10.2",
    "framer-motion": "12.38.0",
    "i18next": "26.7.2",
    "i18next-browser-languagedetector": "8.3.0",
    "i18next-http-backend": "3.0.6",
    "isbot": "5.2.2",
    "lucide-react": "0.563.0",
    "monaco-editor": "0.57.0",
    "posthog-js": "1.447.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "2.6.1",
    "react-i18next": "17.1.13",
    "react-icons": "5.7.0",
    "react-markdown": "10.1.0",
    "react-router": "7.17.0",
    "react-syntax-highlighter": "16.1.2",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "sirv-cli": "3.0.1",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "3.7.0",
    "tailwind-scrollbar": "4.0.2",
    "vite": "7.3.5",
    "zustand": "5.0.16"
  },
  "scripts": {
    "dev": "npm run make-i18n && cross-env VITE_MOCK_API=false react-router dev",
    "dev:mock": "npm run make-i18n && cross-env VITE_MOCK_API=true VITE_MOCK_SAAS=false react-router dev",
    "dev:mock:saas": "npm run make-i18n && cross-env VITE_MOCK_API=true VITE_MOCK_SAAS=true react-router dev",
    "build": "npm run make-i18n && cross-env NODE_OPTIONS=--max-old-space-size=4096 react-router build",
    "build:agent-canvas": "bash scripts/build-agent-canvas.sh",
    "start": "npx sirv-cli build/ --single",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "npm run make-i18n && vitest run --coverage",
    "dev_wsl": "VITE_WATCH_USE_POLLING=true vite",
    "preview": "vite preview",
    "make-i18n": "node scripts/make-i18n-translations.cjs",
    "prelint": "npm run make-i18n",
    "lint": "npm run typecheck && eslint src && prettier --check src/**/*.{ts,tsx}",
    "lint:fix": "eslint src --fix && prettier --write src/**/*.{ts,tsx}",
    "prepare": "cd .. && husky frontend/.husky",
    "typecheck": "react-router typegen && tsc",
    "typecheck:staged": "react-router typegen && npx tsc --noEmit --skipLibCheck",
    "check-translation-completeness": "node scripts/check-translation-completeness.cjs"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{ts,tsx}": [
      "bash -c 'npm run typecheck:staged'"
    ],
    "src/**/*": [
      "npm run check-translation-completeness"
    ]
  },
  "devDependencies": {
    "@mswjs/socket.io-binding": "0.2.0",
    "@playwright/test": "1.65.0",
    "@react-router/dev": "7.17.0",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/eslint-plugin-query": "5.105.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "25.8.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "4.1.8",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "jsdom": "27.4.0",
    "lint-staged": "16.2.7",
    "msw": "2.12.7",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite-plugin-svgr": "4.5.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.8"
  },
  "packageManager": "npm@10.5.0",
  "volta": {
    "node": "22.12.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "dompurify": "3.4.11",
    "qs": "6.15.2",
    "@opentelemetry/core": "2.8.0",
    "ws": ">=8.21.0",
    "postcss": ">=8.5.18"
  }
}
