# =============================================================================
# Local SaaS Debugging Secrets Template
#
# Copy this file to `.env` (gitignored) and fill in real values:
#   cp .env.template .env
#
# This file contains ONLY secrets and credentials. All non-sensitive config
# (hostnames, ports, paths, feature flags) is baked into .vscode/launch.json
# inline via the `env` block, which overrides values from this file.
#
# See dev_config/local_saas/README.md → "Debugger workflow" for full instructions.
# =============================================================================

# ---- Database password (local PostgreSQL via `make local-db`) ----
DB_PASS=postgres

# ---- Keycloak secrets ----
# Harvest from staging: kubectl exec --stdin --tty <POD> -n <NS> -- /bin/bash -c printenv
KEYCLOAK_CLIENT_SECRET=<your-keycloak-client-secret>
KEYCLOAK_ADMIN_PASSWORD=<your-keycloak-admin-password>

# ---- LLM proxy API key ----
LITE_LLM_API_KEY=<your-lite-llm-api-key>

# ---- PostHog (optional -- leave empty to disable) ----
POSTHOG_CLIENT_KEY=

# ---- GitHub App (optional -- only needed for GitHub integration testing) ----
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# ---- JWT secret (optional -- auto-generated if unset) ----
# Set a fixed value if you want sessions to survive restarts:
# JWT_SECRET=<generate-with: openssl rand -base64 32>
