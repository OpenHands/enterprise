# =============================================================================
# Local SaaS Debugging Secrets Template
#
# Copy this file to `.env` (gitignored) and fill in real values:
#   cp .env.template .env
#
# This file contains ONLY secrets and credentials. All non-sensitive config
# (hostnames, ports, paths, feature flags, service class names) is baked into
# .vscode/launch.json inline via the `env` block, which overrides values from
# this file.
#
# Harvest real values from staging:
#   kubectl exec --stdin --tty <POD> -n <NS> -- /bin/bash -c printenv
# NOTE: _DO NOT DO THIS WITH PROD!!!_
#
# See dev_config/local_saas/README.md → "Debugger workflow" for full instructions.
# =============================================================================

# ---- Database password (local PostgreSQL via `make local-db`) ----
DB_PASS=postgres

# ---- Keycloak secrets ----
KEYCLOAK_CLIENT_SECRET=<your-keycloak-client-secret>
KEYCLOAK_ADMIN_PASSWORD=<your-keycloak-admin-password>

# ---- LLM proxy ----
LITE_LLM_API_KEY=<your-lite-llm-api-key>
LITE_LLM_TEAM_ID=<your-lite-llm-team-id>

# ---- Remote runtime API key (staging) ----
# Used by DynamicRemoteSandboxSpecServiceInjector to talk to runtime.staging.all-hands.dev
SANDBOX_API_KEY=<your-staging-runtime-api-key>

# ---- GitHub App ----
GITHUB_APP_ID=<your-github-app-id>
GITHUB_APP_PRIVATE_KEY=<your-github-app-private-key>
GITHUB_APP_CLIENT_ID=<your-github-app-client-id>
GITHUB_APP_CLIENT_SECRET=<your-github-app-client-secret>

# ---- Stripe (billing) ----
STRIPE_API_KEY=<your-stripe-api-key>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>

# ---- PostHog ----
POSTHOG_CLIENT_KEY=<your-posthog-client-key>

# ---- Tavily (MCP search engine) ----
TAVILY_API_KEY=<your-tavily-api-key>

# ---- JWT secret (optional -- auto-generated if unset) ----
# Set a fixed value if you want sessions to survive restarts:
# JWT_SECRET=<generate-with: openssl rand -base64 32>

# ---- Local dev role-swapping helper (scripts/dev_user_roles.py) ----
# Your Keycloak sub / user UUID. Used by scripts/dev_user_roles.py to swap
# your local user between org-admin / org-member / superadmin for QA.
# Grab it from the DB after logging in once:
#   docker exec -i openhands-postgres psql -U postgres -d openhands \
#     -c 'SELECT id, email FROM "user";'
DEV_USER_ID=<paste-your-keycloak-sub>
