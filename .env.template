# =============================================================================
# Local SaaS Debugging Environment Template
#
# Copy this file to `.env` (gitignored) and fill in real values:
#   cp .env.template .env
#
# The VSCode launch.json loads `.env` automatically via `envFile`.
# See dev_config/local_saas/README.md → "Debugger workflow" for full instructions.
# =============================================================================

# ---- App / SaaS config ----
DEBUG=1
OPENHANDS_CONFIG_CLS=server.config.SaaSServerConfig
SERVE_FRONTEND=false
FILE_STORE=local
# Local file store path (adjust to your machine)
FILE_STORE_PATH=/tmp/.openhands-state
# Where the built frontend lives (served by SPAStaticFiles)
FRONTEND_DIRECTORY=/path/to/enterprise/frontend/build

# ---- Web host / CORS ----
# MUST be "localhost" (not localhost:3030) so IS_LOCAL_ENV=true, which:
#   - makes cookies SameSite=Lax (not Strict)
#   - sets no cookie domain (scoped to localhost)
#   - makes the Secure flag false (correct for HTTP)
WEB_HOST=localhost
PERMITTED_CORS_ORIGINS=http://localhost:3030

# ---- CSP ----
# The default CSP allows 'self' + PostHog endpoints + runtime_hosts.
# On localhost, runtime_hosts is empty (single-label host), so the default
# policy works as-is. Set to empty string to disable CSP if you hit issues:
# CONTENT_SECURITY_POLICY=

# ---- Database (local PostgreSQL via `make local-db`) ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=openhands
DB_USER=postgres
DB_PASS=postgres

# ---- Keycloak auth ----
# Use the staging Keycloak server. KEYCLOAK_SERVER_URL is the internal URL
# the backend uses to talk to Keycloak (can be localhost if running locally).
# KEYCLOAK_SERVER_URL_EXT is the browser-facing URL the browser redirects to.
KEYCLOAK_SERVER_URL=https://keycloak.staging.all-hands.dev
KEYCLOAK_SERVER_URL_EXT=https://keycloak.staging.all-hands.dev
KEYCLOAK_REALM_NAME=allhands
KEYCLOAK_CLIENT_ID=openhands
KEYCLOAK_CLIENT_SECRET=<your-keycloak-client-secret>
KEYCLOAK_ADMIN_PASSWORD=<your-keycloak-admin-password>
# AUTH_WEB_HOST is used to derive KEYCLOAK_SERVER_URL_EXT if that var is unset.
AUTH_WEB_HOST=keycloak.staging.all-hands.dev

# ---- LLM proxy (staging) ----
LITE_LLM_API_URL=https://llm-proxy.staging.all-hands.dev
LITE_LLM_TEAM_ID=62ea39c4-8886-44f3-b7ce-07ed4fe42d2c
LITE_LLM_API_KEY=<your-lite-llm-api-key>

# ---- PostHog (optional — leave empty to disable) ----
POSTHOG_CLIENT_KEY=

# ---- GitHub App (optional — only needed for GitHub integration testing) ----
# Obtain these from the deploy repo or `kubectl exec` into a staging pod.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# ---- JWT secret (optional — auto-generated if unset) ----
# Set a fixed value if you want sessions to survive restarts:
# JWT_SECRET=<generate-with: openssl rand -base64 32>
